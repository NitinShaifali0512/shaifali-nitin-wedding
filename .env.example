# ---------------------------------------------------------------------------
# Settings for the wedding website.
#
# For local work: copy this file to ".env.local" and fill in the values.
# For the live website: enter the same names and values in your host's
# "Environment Variables" page (Vercel or Netlify), then deploy again.
#
# Only PUBLIC values belong here. Never put a database password, a Supabase
# "secret" key or a "service_role" key in this file or in your host's settings
# for this website.
# ---------------------------------------------------------------------------

# Your Supabase project address. It looks like https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Your Supabase PUBLISHABLE key (it starts with "sb_publishable_").
# In older projects this is called the "anon public" key (a long text starting
# with "eyJ"); if you have that one, use VITE_SUPABASE_ANON_KEY below instead.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only for older Supabase projects that show an "anon" key instead of a publishable key.
# VITE_SUPABASE_ANON_KEY=

# The full address of the live website, for example https://shaifali-nitin.vercel.app
# It is used for the WhatsApp link preview. On Vercel and Netlify you may leave
# it empty and the address is detected automatically; set it if you use your
# own domain name.
VITE_SITE_URL=


# Only for hosts that serve the website from a folder, such as GitHub Pages
# (https://name.github.io/wedding/). Leave it out on Vercel and Netlify.
# The GitHub workflow in .github/workflows sets it automatically.
# VITE_BASE_PATH=/wedding/
